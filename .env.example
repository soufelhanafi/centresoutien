# Centre Soutien — environment variables (example)
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and must
# NEVER be committed. These variables are read ONLY in the Electron main process.

# Demo mode admin credentials (SOU-186).
#
# The "Mode démo" sales tool seeds a throwaway demo center with an admin login.
# Those credentials are NOT hardcoded anywhere in source: the main process reads
# them from these two variables, seeds the demo admin with them, and exposes them
# to the login screen (for prefill) via the `demo.status` IPC channel.
#
# When either is unset/empty, `demo.create` fails loud with a clear error and demo
# mode is simply unavailable — the rest of the app is unaffected. Use throwaway,
# non-production values here; the demo DB is disposable.
CS_DEMO_USERNAME=demo
CS_DEMO_PASSWORD=change-me
