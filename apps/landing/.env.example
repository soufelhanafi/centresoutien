# Resend transactional email (Programme Fondateur notifications)
RESEND_API_KEY=
# Recipient distribution address for founder applications
FOUNDER_NOTIFICATION_EMAIL=founder-applications@centresoutien.com
# Verified Resend sending address
RESEND_FROM_EMAIL="Centre Soutien <noreply@centresoutien.com>"
# Salt for hashing IPs before they touch any output (rate limiting only)
IP_HASH_SALT=
# Upstash Redis REST — durable rate limiting + the password-reset code store
# (SOU-207 / SOU-157). Without these the founder limiter falls back to a
# per-instance in-memory map and the reset routes throw in production
# (reset_store_not_configured). Set them in Netlify before deploy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Password-reset-by-email relay (SOU-157) — all REQUIRED in production;
# the routes throw at startup of the flow if any is missing. ---
# Server-side pepper mixed into every reset-code hash (never stored in Redis);
# makes an offline brute force of the 6-digit space infeasible from a dump alone.
RESET_CODE_PEPPER=
# Salt for the one-way email hash written to reset audit logs (no PII in logs).
AUDIT_HASH_SALT=
# AWS SES outbound (us-east-1). The IAM key is scoped to
# ses:FromAddress = noreply@centresoutien.com and lives ONLY here / in Netlify —
# never in the desktop bundle or the repo.
SES_REGION=us-east-1
SES_FROM="Centre Soutien <noreply@centresoutien.com>"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
