{
  "name": "@centresoutien/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node ./scripts/native-abi.mjs electron && electron-vite dev",
    "start": "node ./scripts/native-abi.mjs electron && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "electron-vite build",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
    "rebuild:node": "node ./scripts/native-abi.mjs node",
    "test:e2e": "node ./scripts/native-abi.mjs electron && playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@node-rs/argon2": "^2.0.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-i18next": "^17.0.11",
    "ulid": "^2.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@centresoutien/config": "workspace:*",
    "@centresoutien/domain": "workspace:*",
    "@centresoutien/ui": "workspace:*",
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6"
  }
}
